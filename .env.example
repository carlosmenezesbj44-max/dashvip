IXC_BASE_URL=https://seu-servidor-ixc.com.br
IXC_TOKEN=SEU_TOKEN_OU_BASIC_TOKEN

# Tabela principal de ordens de servico no IXC
IXC_OS_TABLE=su_oss_chamado
IXC_OS_ID_FIELD=id
IXC_OS_STATUS_FIELD=status
IXC_OS_SUBJECT_ID_FIELD=id_assunto
IXC_OS_BRANCH_ID_FIELD=id_filial
IXC_OS_BRANCH_NAME_FIELD=filial
IXC_OS_TECH_ID_FIELD=id_tecnico
IXC_OS_OPENED_AT_FIELD=data_abertura
IXC_OS_EXECUTION_AT_FIELD=data_hora_execucao
IXC_OS_CLOSED_AT_FIELD=data_fechamento
IXC_OS_DUE_AT_FIELD=data_prazo_limite

# Tabela para resolver assunto (id -> nome)
IXC_SUBJECT_TABLE=su_oss_assunto
IXC_SUBJECT_ID_FIELD=id
IXC_SUBJECT_NAME_FIELD=assunto

# Tabela para resolver tecnico (id -> nome)
IXC_TECH_TABLE=funcionario
IXC_TECH_ID_FIELD=id
IXC_TECH_NAME_FIELD=funcionario

# Tabela para resolver cidade (id_cidade -> nome)
IXC_CITY_TABLE=cidade
IXC_CITY_ID_FIELD=id
IXC_CITY_NAME_FIELD=nome

# Status usados para calculo
IXC_STATUS_CLOSED=F,FINALIZADA,CONCLUIDA
IXC_STATUS_EXECUTION=E,EM_EXECUCAO,EM_ANDAMENTO

# Sincronizacao
IXC_PAGE_SIZE=1000
IXC_MAX_PAGES=500
IXC_INCREMENTAL_SYNC=true
IXC_FULL_SYNC_EVERY_N_RUNS=12
IXC_SYNC_ON_STARTUP=true
IXC_AUTO_SYNC=true
IXC_SYNC_INTERVAL_SECONDS=300
IXC_VERIFY_SSL=true
IXC_HTTP_TIMEOUT_SECONDS=60

# Aplicacao
APP_TIMEZONE=America/Sao_Paulo
APP_DB_PATH=./data/dashboard.db
APP_DASHBOARD_REFRESH_SECONDS=30
APP_FILTER_OPTIONS_REFRESH_SECONDS=180
APP_SUBJECT_GROUPS=
